    <!-- Glass fills / borders (semi-transparent white over the dark background) -->
    <color name="color_glass_fill_l2">#14FFFFFF</color>
    <color name="color_glass_fill_l3">#26FFFFFF</color>
    <!-- Level-3 sheet solid base — sits under the blur + highlight gradient below so the sheet
         has real body/contrast instead of reading as too see-through against busy content. -->
    <color name="color_glass_fill_l3_base">#E0171F33</color>
    <!-- Level-3 sheet gradient tint — a neutral white "catching light" wash (bright top-left
         fading to dim bottom-right), not a hue-tinted one. A colored tint here fights the real
         backdrop blur (applyGlassBlur) instead of reading as an extension of it — whatever's
         actually behind the sheet should show through in its own color, blurred, not painted
         over with an unrelated fixed hue. -->
    <color name="color_glass_fill_l3_bright">#33FFFFFF</color>
    <color name="color_glass_fill_l3_dim">#14FFFFFF</color>
    <color name="color_glass_border">#1FFFFFFF</color>
    <color name="color_glass_border_bright">#33FFFFFF</color>

    <!-- Brand -->
    <color name="color_primary">#6366F1</color>
    <color name="color_secondary">#8B5CF6</color>
    <color name="color_on_primary">#FFFFFF</color>

    <!-- Stitch's own generated M3 "primary" token (#c0c1ff, a pale lavender) — distinct from
         this app's brand indigo color_primary (#6366F1). The Edit Transaction reference tints
         its row icons with this token at 70% opacity (text-primary/70), which reads much
         lighter/softer than the saturated brand indigo would at the same opacity. -->
    <color name="color_icon_lavender">#C0C1FF</color>
    <color name="color_icon_lavender_10">#1AC0C1FF</color>
    <color name="color_icon_lavender_20">#33C0C1FF</color>

    <!-- Stitch's M3 "secondary" token (#d0bcff, a pale violet) — used the same way as
         color_icon_lavender above but for rows tagged with the design's secondary accent
         (e.g. the Add Transaction hub's "Manual Entry" row). -->
    <color name="color_icon_violet">#D0BCFF</color>
    <color name="color_icon_violet_10">#1AD0BCFF</color>
    <color name="color_icon_violet_20">#33D0BCFF</color>

