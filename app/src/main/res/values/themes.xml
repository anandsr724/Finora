<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme — Luminous Finance, dark-only glassmorphism -->
    <style name="Theme.ExpenseTracker" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_secondary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/color_on_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/color_bg</item>
        <!-- Material color compatibility attributes used in layouts -->
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_high</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_muted</item>
        <item name="colorOnBackground">@color/color_on_surface</item>
        <item name="colorOutline">@color/color_glass_border</item>
        <item name="selectableItemBackgroundBorderless">?attr/selectableItemBackground</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!-- Bottom sheet with no entrance/exit animation -->
    <style name="BottomSheetDialog.NoAnim" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:windowAnimationStyle">@style/Animation.BottomSheet.NoAnim</item>
    </style>

    <style name="Animation.BottomSheet.NoAnim" parent="android:Animation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <!-- Luminous Finance type scale -->
    <style name="TextAppearance.Finora.DisplayLg" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="fontFamily">@font/hanken_grotesk</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.Finora.HeadlineLg" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="fontFamily">@font/hanken_grotesk</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.Finora.HeadlineLgMobile" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/hanken_grotesk</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.Finora.NumericXl" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="fontFamily">@font/hanken_grotesk</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.Finora.BodyLg" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.Finora.BodyMd" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.Finora.LabelSm" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/color_on_surface_muted</item>
    </style>

    <!-- Luminous Finance shape tokens -->
    <style name="ShapeAppearance.Finora.Card" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.Finora.Pill" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Primary gradient pill button (Upload Statement, Save, Confirm Import, ...) -->
    <style name="Widget.Finora.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/balance_card_gradient</item>
        <item name="cornerRadius">999dp</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Secondary frosted-glass ghost pill button (Add Manual, Edit, Cancel, ...) -->
    <style name="Widget.Finora.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="strokeColor">@color/color_glass_border_bright</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/color_glass_fill_l2</item>
        <item name="cornerRadius">999dp</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
