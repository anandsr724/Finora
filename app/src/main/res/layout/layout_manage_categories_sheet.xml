<?xml version="1.0" encoding="utf-8"?>
<com.example.expensetracker.ui.common.GlassCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:glassLevel="level3"
    app:glassCornerRadius="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/colorGlassBorderBright" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Manage Categories"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/hanken_grotesk"
                android:textColor="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/closeCategoriesSheetButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/shape_circle"
                android:padding="10dp"
                android:tint="?attr/colorOnSurfaceMuted"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Add New Category Button (top, always visible) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addNewCategoryButton"
            style="@style/Widget.Finora.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:text="+ Add Category" />

        <!-- Restore Defaults Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/restoreDefaultsButton"
            style="@style/Widget.Finora.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="14dp"
            android:text="Restore Default Categories"
            android:textSize="13sp" />

        <!-- Categories RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/manageCategoriesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="420dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true" />

    </LinearLayout>
</com.example.expensetracker.ui.common.GlassCardView>
