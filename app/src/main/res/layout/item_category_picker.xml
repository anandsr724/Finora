<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/categoryPickerCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorGlassBorder"
    app:cardBackgroundColor="?attr/colorGlassFillL2"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <!-- Icon circle -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/categoryIconCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorGlassFillL3">

                <ImageView
                    android:id="@+id/categoryPickerIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:tint="@color/color_primary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Multi-select checkmark badge (filter sheet only; gone by default) -->
            <ImageView
                android:id="@+id/categoryPickerCheck"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/color_primary"
                android:padding="3dp"
                android:src="@drawable/ic_check"
                android:tint="@color/color_on_primary"
                android:visibility="gone"
                android:contentDescription="Selected" />
        </FrameLayout>

        <TextView
            android:id="@+id/categoryPickerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:fontFamily="@font/inter"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
