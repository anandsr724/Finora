<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_luminous_glow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="100dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textAppearance="@style/TextAppearance.Finora.HeadlineLgMobile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage your financial environment"
                android:textSize="13sp"
                android:textColor="@color/color_on_surface_muted"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Manage Categories Section -->
        <com.example.expensetracker.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:glassLevel="level2"
            app:glassCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header row: title + count + Manage button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Categories"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_on_surface" />

                        <TextView
                            android:id="@+id/categoriesCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 total"
                            android:textSize="13sp"
                            android:textColor="@color/color_on_surface_muted"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Ghost pill Manage button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/manageCategoriesButton"
                        style="@style/Widget.Finora.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Manage"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Horizontal scrollable category preview chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/categoryPreviewContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>

        <!-- Data Section -->
        <com.example.expensetracker.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:glassLevel="level2"
            app:glassCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_surface"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export or import your transaction history as a CSV file"
                    android:textSize="13sp"
                    android:textColor="@color/color_on_surface_muted"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/export_csv_button"
                    style="@style/Widget.Finora.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Export to CSV"
                    android:textSize="15sp"
                    android:layout_marginBottom="10dp"
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/import_csv_button"
                    style="@style/Widget.Finora.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Import from CSV"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_glass_border"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Upload Statement row -->
                <LinearLayout
                    android:id="@+id/uploadStatementRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/glass_row_background"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/color_glass_fill_l3"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_upload"
                            android:tint="@color/color_primary"
                            android:scaleType="centerInside"
                            android:padding="10dp"
                            android:contentDescription="Upload statement" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Upload Statement"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_on_surface"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NEW"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:background="@drawable/badge_background"
                                android:backgroundTint="@color/color_primary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Import past transactions from bank statements in bulk"
                            android:textSize="12sp"
                            android:textColor="@color/color_on_surface_muted"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_back"
                        android:tint="@color/color_on_surface_muted"
                        android:scaleType="centerInside"
                        android:rotation="180"
                        android:contentDescription="Open" />
                </LinearLayout>
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>

        <!-- Appearance Section -->
        <com.example.expensetracker.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:glassLevel="level2"
            app:glassCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appearance"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_surface"
                    android:layout_marginBottom="14dp" />

                <!-- Default Currency Row -->
                <LinearLayout
                    android:id="@+id/defaultCurrencyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/glass_row_background"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/color_glass_fill_l3"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_manage"
                            android:scaleType="centerInside"
                            android:tint="@color/color_on_surface_muted"
                            android:padding="9dp"
                            android:contentDescription="Currency" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Default Currency"
                            android:textSize="14sp"
                            android:textColor="@color/color_on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Used for all calculations &amp; display"
                            android:textSize="12sp"
                            android:textColor="@color/color_on_surface_muted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/defaultCurrencyValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ INR"
                        android:textSize="14sp"
                        android:textColor="@color/color_primary"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>

        <!-- About Section -->
        <com.example.expensetracker.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:glassLevel="level2"
            app:glassCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About Finora"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_surface"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Version 1.0.0"
                    android:textSize="13sp"
                    android:textColor="@color/color_on_surface_muted"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automatically extract and manage your UPI payment transactions with ease."
                    android:textSize="13sp"
                    android:textColor="@color/color_on_surface_muted" />
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>

        <!-- Beta Section -->
        <com.example.expensetracker.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:glassLevel="level2"
            app:glassCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Beta"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BETA"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/badge_background"
                        android:backgroundTint="#F59E0B" />
                </LinearLayout>

                <!-- OCR Data Capture Toggle Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/glass_row_background"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/color_glass_fill_l3"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_camera"
                            android:scaleType="centerInside"
                            android:tint="@color/color_on_surface_muted"
                            android:padding="9dp"
                            android:contentDescription="Save screenshots" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OCR Data Capture"
                            android:textSize="14sp"
                            android:textColor="@color/color_on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Saves screenshot + OCR predictions on each recorded transaction"
                            android:textSize="12sp"
                            android:textColor="@color/color_on_surface_muted" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/saveScreenshotsSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/color_primary" />
                </LinearLayout>

                <!-- Get Feedback Toggle Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/glass_row_background">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/color_glass_fill_l3"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_edit"
                            android:scaleType="centerInside"
                            android:tint="@color/color_on_surface_muted"
                            android:padding="9dp"
                            android:contentDescription="Get feedback" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Get Feedback"
                            android:textSize="14sp"
                            android:textColor="@color/color_on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ask for OCR accuracy rating after each save (requires OCR Data Capture)"
                            android:textSize="12sp"
                            android:textColor="@color/color_on_surface_muted" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/feedbackSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/color_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>

        <!-- Account Security Section -->
        <com.example.expensetracker.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:glassLevel="level2"
            app:glassCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Security"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_surface"
                    android:layout_marginBottom="14dp" />

                <!-- Clear Data -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clear_all_data_button"
                    style="@style/Widget.Finora.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Clear All Data"
                    android:textSize="14sp"
                    android:textColor="@color/color_expense"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconTint="@color/color_expense"
                    app:backgroundTint="@color/color_expense_container"
                    app:strokeColor="@color/color_expense" />
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>

        <!-- Tip Info Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/info_box_background"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Tip"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/color_secondary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use the camera button on the home screen to quickly process payment screenshots from Google Pay, PhonePe, or ICICI Bank."
                android:textSize="12sp"
                android:textColor="@color/color_on_surface_muted" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
