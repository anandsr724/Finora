<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="100dp">

        <!-- Upload Section Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Process Payment Screenshot"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload or share a UPI payment screenshot to automatically extract transaction details"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectImageButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload Screenshot"
                    android:textSize="16sp"
                    android:padding="16dp"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/gradient_start"
                    app:icon="@android:drawable/ic_menu_upload"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Image Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/imagePreviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:contentDescription="Payment screenshot preview" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Process Button Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/processButtonCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/processButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Process Image"
                android:textSize="16sp"
                android:padding="16dp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/gradient_start"
                app:icon="@android:drawable/ic_menu_compass"
                app:iconTint="@color/white"
                android:enabled="false" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Status Text Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="300dp"
                android:padding="20dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select an image to get started"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="4dp" />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons Container -->
        <LinearLayout
            android:id="@+id/buttonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Save"
                android:textSize="16sp"
                android:padding="16dp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/emerald_500"
                app:icon="@android:drawable/ic_menu_save"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Edit"
                android:textSize="16sp"
                android:padding="16dp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/primary_indigo"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>