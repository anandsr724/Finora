<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bgGlowDrawable">

    <ViewFlipper
        android:id="@+id/addFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- STATE 0: Method Hub -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingTop="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="100dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add Transaction"
                        android:textAppearance="@style/TextAppearance.Finora.HeadlineLgMobile" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select a method to log your expense or income with financial clarity."
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceMuted"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Method Hub — three glass rows, matching Stitch's "Add Transaction -
                     Statement Import Variant" screen -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.example.expensetracker.ui.common.GlassCardView
                        android:id="@+id/uploadReceiptRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:glassLevel="level2"
                        app:glassCornerRadius="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="20dp">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/icon_chip_bg_lavender"
                                android:layout_marginEnd="16dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="14dp"
                                    android:src="@drawable/ic_upload_file"
                                    android:tint="@color/color_icon_lavender"
                                    android:contentDescription="Upload Receipt" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Upload Receipt"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Import from files or gallery"
                                    android:textSize="13sp"
                                    android:textColor="?attr/colorOnSurfaceMuted"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chevron_right"
                                android:tint="?attr/colorOnSurfaceFaint"
                                android:contentDescription="@null" />
                        </LinearLayout>
                    </com.example.expensetracker.ui.common.GlassCardView>

                    <com.example.expensetracker.ui.common.GlassCardView
                        android:id="@+id/manualEntryRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:glassLevel="level2"
                        app:glassCornerRadius="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="20dp">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/icon_chip_bg_violet"
                                android:layout_marginEnd="16dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="14dp"
                                    android:src="@drawable/ic_edit_note"
                                    android:tint="@color/color_icon_violet"
                                    android:contentDescription="Manual Entry" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Manual Entry"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Enter details manually"
                                    android:textSize="13sp"
                                    android:textColor="?attr/colorOnSurfaceMuted"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chevron_right"
                                android:tint="?attr/colorOnSurfaceFaint"
                                android:contentDescription="@null" />
                        </LinearLayout>
                    </com.example.expensetracker.ui.common.GlassCardView>

                    <com.example.expensetracker.ui.common.GlassCardView
                        android:id="@+id/importStatementRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:glassLevel="level2"
                        app:glassCornerRadius="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="20dp">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/icon_chip_bg_emerald"
                                android:layout_marginEnd="16dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="14dp"
                                    android:src="@drawable/ic_cloud_upload"
                                    android:tint="@color/color_income"
                                    android:contentDescription="Import from Statement" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Import from Statement"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bulk import transactions from bank statements"
                                    android:textSize="13sp"
                                    android:textColor="?attr/colorOnSurfaceMuted"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chevron_right"
                                android:tint="?attr/colorOnSurfaceFaint"
                                android:contentDescription="@null" />
                        </LinearLayout>
                    </com.example.expensetracker.ui.common.GlassCardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- STATE 1: Receipt Preview — matches Stitch's "Upload Receipt - Preview" screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageButton
                    android:id="@+id/previewBackButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="@drawable/shape_circle"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:padding="10dp"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="Back"
                    android:layout_marginEnd="14dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Receipt Preview"
                    android:textAppearance="@style/TextAppearance.Finora.HeadlineLgMobile" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/pill_badge_bg_lavender"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="20dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/shape_circle"
                    android:backgroundTint="@color/color_income"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="READY FOR SCAN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="@color/color_icon_lavender" />
            </LinearLayout>

            <!-- Viewfinder frame -->
            <com.example.expensetracker.ui.common.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:glassLevel="level2"
                app:glassCornerRadius="24dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorGlassBorder">

                        <ImageView
                            android:id="@+id/previewImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Receipt preview" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <!-- Corner accents sit at the outer card's own corners (not the inset image's),
                     with an arc radius matching the card's 24dp corner and a lighter, 40%-alpha
                     tint, matching Stitch's border-primary/40 scan-frame accents. -->
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|start"
                    android:alpha="0.4"
                    android:src="@drawable/ic_corner_bracket"
                    android:tint="@color/color_icon_lavender"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|end"
                    android:rotation="90"
                    android:alpha="0.4"
                    android:src="@drawable/ic_corner_bracket"
                    android:tint="@color/color_icon_lavender"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:rotation="180"
                    android:alpha="0.4"
                    android:src="@drawable/ic_corner_bracket"
                    android:tint="@color/color_icon_lavender"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|start"
                    android:rotation="270"
                    android:alpha="0.4"
                    android:src="@drawable/ic_corner_bracket"
                    android:tint="@color/color_icon_lavender"
                    android:contentDescription="@null" />
            </com.example.expensetracker.ui.common.GlassCardView>

            <!-- Floating Hub — Retake + Extract Details combined into one pill, matching
                 Stitch's "Receipt Preview - Floating Hub" screen -->
            <com.example.expensetracker.ui.common.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                app:glassLevel="level2"
                app:glassCornerRadius="32dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="6dp">

                        <LinearLayout
                            android:id="@+id/retakePhotoButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.8"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_refresh"
                                android:tint="?attr/colorOnSurfaceMuted"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Retake"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurfaceMuted" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/extractDetailsButton"
                            style="@style/Widget.Finora.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.3"
                            android:text="Extract Details"
                            android:textSize="13sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>

                    <!-- Positioned independently of the weighted buttons above, so moving it
                         doesn't redistribute their widths. -->
                    <View
                        android:id="@+id/hubDivider"
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="126dp"
                        android:background="?attr/colorGlassBorderBright" />
                </FrameLayout>
            </com.example.expensetracker.ui.common.GlassCardView>
        </LinearLayout>

        <!-- STATE 2: Extracting — matches Stitch's "Upload Receipt - Extracting" screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageButton
                    android:id="@+id/extractingCloseButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/shape_circle"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:padding="10dp"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="Cancel" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Finora"
                    android:textAppearance="@style/TextAppearance.Finora.HeadlineLgMobile" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp" />
            </LinearLayout>

            <com.example.expensetracker.ui.common.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:glassLevel="level2"
                app:glassCornerRadius="24dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/extractingImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:alpha="0.35"
                        android:contentDescription="@null" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/colorAppBg"
                        android:alpha="0.35" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_marginBottom="24dp">

                            <ProgressBar
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminateTint="@color/color_icon_lavender" />

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_document_scanner"
                                android:tint="@color/color_icon_lavender"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Extracting Details"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/extractingStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reading your receipt…"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceMuted"
                            android:gravity="center" />
                    </LinearLayout>
                </FrameLayout>
            </com.example.expensetracker.ui.common.GlassCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelExtractionButton"
                style="@style/Widget.Finora.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="Cancel"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
    </ViewFlipper>
</FrameLayout>
