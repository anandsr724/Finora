<?xml version="1.0" encoding="utf-8"?>
<com.example.expensetracker.ui.common.GlassCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:glassLevel="level3"
    app:glassCornerRadius="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rate the accuracy of the extracted details"
            android:textAppearance="@style/TextAppearance.Finora.BodyMd"
            android:textColor="?attr/colorOnSurfaceMuted"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/ratingToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="false"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRatingCorrect"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Correct"
                android:textSize="12sp"
                android:textColor="@color/color_income"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_check"
                app:iconTint="@color/color_income"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:backgroundTint="@color/color_income_container"
                app:strokeColor="@color/color_income"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRatingPartial"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Partial"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="?attr/colorGlassFillL2"
                app:strokeColor="?attr/colorGlassBorderBright"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRatingIncorrect"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Incorrect"
                android:textSize="12sp"
                android:textColor="@color/color_expense"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/color_expense"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:backgroundTint="@color/color_expense_container"
                app:strokeColor="@color/color_expense"
                app:strokeWidth="1dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Comments (optional)"
            android:textColorHint="?attr/colorOnSurfaceFaint"
            app:hintTextColor="?attr/colorOnSurfaceFaint"
            app:boxBackgroundMode="none">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFeedbackComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_input_well_background"
                android:padding="12dp"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:maxLines="4"
                android:gravity="top"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceFaint" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</com.example.expensetracker.ui.common.GlassCardView>
