<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/bgGlowDrawable"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="100dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reports"
                android:textAppearance="@style/TextAppearance.Finora.HeadlineLgMobile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyze your spending patterns"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceMuted"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Month Selector -->
        <com.example.expensetracker.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            app:glassLevel="level2"
            app:glassCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar_month"
                    android:tint="@color/color_primary"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Calendar" />

                <Spinner
                    android:id="@+id/monthSpinner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@null"
                    android:spinnerMode="dropdown"
                    android:popupBackground="@drawable/dropdown_popup_bg" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="?attr/colorOnSurfaceMuted"
                    android:contentDescription="Expand" />
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>

        <!-- Total Spent — full width -->
        <com.example.expensetracker.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:glassLevel="level2"
            app:glassCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_wallet"
                        android:tint="?attr/colorOnSurfaceMuted"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="Wallet" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL SPENT"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="?attr/colorOnSurfaceMuted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/totalSpentAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/hanken_grotesk"
                    android:textColor="@color/color_icon_lavender"
                    android:shadowColor="@color/color_icon_lavender_20"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="12" />
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>

        <!-- 1. Transactions + 2. Avg per Txn -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Transactions -->
            <com.example.expensetracker.ui.common.GlassCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:glassLevel="level2"
                app:glassCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_trending_up"
                            android:tint="?attr/colorOnSurfaceMuted"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Transactions" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRANSACTIONS"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="?attr/colorOnSurfaceMuted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/transactionCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/hanken_grotesk"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </com.example.expensetracker.ui.common.GlassCardView>

            <!-- Average -->
            <com.example.expensetracker.ui.common.GlassCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:glassLevel="level2"
                app:glassCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_analytics"
                            android:tint="?attr/colorOnSurfaceMuted"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Average" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AVG PER TXN"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="?attr/colorOnSurfaceMuted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/avgTransactionAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/hanken_grotesk"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </com.example.expensetracker.ui.common.GlassCardView>
        </LinearLayout>

        <!-- 3. Top Category + 4. vs Last Month -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Top Category — own visibility toggle -->
            <com.example.expensetracker.ui.common.GlassCardView
                android:id="@+id/topCategoryCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:glassLevel="level2"
                app:glassCornerRadius="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_category"
                            android:tint="?attr/colorOnSurfaceMuted"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Top category" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOP CATEGORY"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="?attr/colorOnSurfaceMuted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/shape_circle"
                            android:backgroundTint="?attr/colorGlassFillL2"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:id="@+id/topCategoryIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="7dp"
                                android:scaleType="centerInside"
                                android:tint="@color/color_primary"
                                android:contentDescription="Category icon" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/topCategoryName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Category"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/topCategoryAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0"
                                android:textSize="11sp"
                                android:textColor="?attr/colorOnSurfaceMuted" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.example.expensetracker.ui.common.GlassCardView>

            <!-- vs Last Month — own visibility toggle -->
            <com.example.expensetracker.ui.common.GlassCardView
                android:id="@+id/momCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:glassLevel="level2"
                app:glassCornerRadius="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_trending_down"
                            android:tint="?attr/colorOnSurfaceMuted"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="vs Last Month" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VS LAST MONTH"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="?attr/colorOnSurfaceMuted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/momChangeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/hanken_grotesk"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </com.example.expensetracker.ui.common.GlassCardView>
        </LinearLayout>

        <!-- Spending by Category Card -->
        <com.example.expensetracker.ui.common.GlassCardView
            android:id="@+id/categoryChartCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:glassLevel="level2"
            app:glassCornerRadius="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spending by Category"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/hanken_grotesk"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="16dp" />

                <!-- Pie Chart -->
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChart"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginBottom="16dp" />

                <!-- Category Legend -->
                <LinearLayout
                    android:id="@+id/categoryLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>

        <!-- Monthly Trend Card -->
        <com.example.expensetracker.ui.common.GlassCardView
            android:id="@+id/monthlyTrendCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:glassLevel="level2"
            app:glassCornerRadius="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header with toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Monthly Spending Trend"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/hanken_grotesk"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chartToggleButton"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="Total"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textAllCaps="true"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/color_primary"
                        app:backgroundTint="?attr/colorGlassFillL2"
                        app:cornerRadius="999dp"
                        app:strokeWidth="0dp"
                        style="@style/Widget.MaterialComponents.Button" />
                </LinearLayout>

                <!-- Line Chart -->
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="256dp" />
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyStateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <com.example.expensetracker.ui.common.GlassCardView
                android:layout_width="96dp"
                android:layout_height="96dp"
                app:glassLevel="level2"
                app:glassCornerRadius="48dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:scaleType="centerInside"
                    android:tint="?attr/colorOnSurfaceFaint"
                    android:padding="24dp"
                    android:contentDescription="No data" />
            </com.example.expensetracker.ui.common.GlassCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No data yet"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/emptyStateMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add transactions to see your spending analytics"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceMuted"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
