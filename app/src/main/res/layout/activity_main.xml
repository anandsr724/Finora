<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Wraps the scrolling app content so the nav bar's BlurView below has something to
         snapshot and blur live — see MainActivity.onCreate()'s blurView.setupWith(target) call. -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/mainContentBlurTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:title="ExpenseTracker" />

            </com.google.android.material.appbar.AppBarLayout>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/nav_host_fragment"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:defaultNavHost="true"
                app:navGraph="@navigation/nav_graph" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurTarget>

    <!-- Status bar gradient scrim: fades content that scrolls into the transparent status bar.
         Height matches ~status bar zone; gradient from page background (opaque) to transparent. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@drawable/status_bar_scrim"
        android:importantForAccessibility="no"
        android:clickable="false"
        android:focusable="false" />

    <!-- Bottom nav bar: full-width, flush to the bottom edge, real live backdrop blur (via
         BlurView, snapshotting mainContentBlurTarget) tinted with a translucent overlay + a
         crisp top border drawn as an unblurred child — matches the Stitch "Final Finora"
         reference (not a floating margined pill). Add is a normal 5th item in the row, not a
         raised FAB. -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/bottomNavBlurView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:blurOverlayColor="?attr/colorNavPillTranslucent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="?attr/colorGlassBorderBright" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:itemRippleColor="?attr/colorGlassFillL2"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </eightbitlab.com.blurview.BlurView>

</FrameLayout>
