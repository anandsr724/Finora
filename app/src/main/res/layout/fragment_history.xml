<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_luminous_glow">

    <!-- Header with Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/shape_circle_gradient" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Transactions"
                android:textAppearance="@style/TextAppearance.Finora.HeadlineLgMobile" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_notifications"
                android:tint="@color/color_primary"
                android:contentDescription="Notifications" />
        </LinearLayout>

        <!-- Search Bar -->
        <com.example.expensetracker.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:glassLevel="level2"
            app:glassCornerRadius="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="@color/color_on_surface_muted"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Search" />

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Search merchants or notes..."
                    android:textSize="14sp"
                    android:textColor="@color/color_on_surface"
                    android:textColorHint="@color/color_on_surface_faint"
                    android:background="@null"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>

        <!-- Month Selector + Sort — same row, per the Stitch reference -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <com.example.expensetracker.ui.common.GlassCardView
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                app:glassLevel="level2"
                app:glassCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_calendar_month"
                        android:tint="@color/color_on_surface_muted"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Calendar" />

                    <Spinner
                        android:id="@+id/historyMonthSpinner"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/color_on_surface_muted"
                        android:background="@null"
                        android:spinnerMode="dropdown"
                        android:popupBackground="@drawable/dropdown_popup_bg" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/color_on_surface_muted"
                        android:contentDescription="Expand" />
                </LinearLayout>
            </com.example.expensetracker.ui.common.GlassCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sortButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Newest First"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/color_on_surface_muted"
                app:icon="@drawable/ic_sort"
                app:iconGravity="textEnd"
                app:iconTint="@color/color_on_surface_muted"
                app:iconSize="18dp"
                app:iconPadding="6dp"
                app:backgroundTint="@color/color_glass_fill_l2"
                app:cornerRadius="12dp"
                app:strokeColor="@color/color_glass_border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Category Filter Pills Row — horizontally scrollable, icon+label chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- All pill -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterAllButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="All"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_primary"
                    app:backgroundTint="@color/color_primary"
                    app:cornerRadius="999dp"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MaterialComponents.Button" />

                <!-- Dynamic category icon+label chips -->
                <LinearLayout
                    android:id="@+id/categoryFilterPillsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

                <!-- More filters button with badge overlay -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filterCategoriesButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        app:backgroundTint="@color/color_glass_fill_l2"
                        app:cornerRadius="999dp"
                        app:icon="@drawable/ic_more_horiz"
                        app:iconTint="@color/color_on_surface_muted"
                        app:iconSize="20dp"
                        app:iconPadding="0dp"
                        app:strokeColor="@color/color_glass_border"
                        app:strokeWidth="1dp"
                        android:contentDescription="Filter by category"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <TextView
                        android:id="@+id/filterCategoriesBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-5dp"
                        android:layout_marginEnd="-5dp"
                        android:background="@drawable/badge_background"
                        android:textColor="@color/color_on_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Active category filters display (horizontal scrollable chips) -->
        <HorizontalScrollView
            android:id="@+id/activeCategoryFiltersScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/activeCategoryFiltersContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Transaction List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactions_history_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="110dp"
        android:clipToPadding="false" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <com.example.expensetracker.ui.common.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:glassLevel="level2"
            app:glassCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/shape_circle"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@android:drawable/ic_menu_view"
                        android:scaleType="centerInside"
                        android:tint="@color/color_on_surface_faint"
                        android:padding="20dp"
                        android:contentDescription="No transactions" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No transactions found"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_surface"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/emptyStateMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload a payment screenshot to add your first transaction"
                    android:textSize="14sp"
                    android:textColor="@color/color_on_surface_muted"
                    android:gravity="center" />
            </LinearLayout>
        </com.example.expensetracker.ui.common.GlassCardView>
    </LinearLayout>
</LinearLayout>
