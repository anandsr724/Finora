<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_luminous_glow">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/editHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/shape_circle"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:padding="10dp"
            app:tint="@color/color_on_surface"
            android:contentDescription="Back"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Transaction"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/hanken_grotesk"
                android:textColor="@color/color_on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update transaction details"
                android:textSize="12sp"
                android:textColor="@color/color_on_surface_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Form Card -->
            <com.example.expensetracker.ui.common.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:glassLevel="level2"
                app:glassCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Transaction Type -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Type"
                            android:textSize="13sp"
                            android:textColor="@color/color_on_surface_muted"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:orientation="horizontal"
                            android:background="@drawable/rounded_input_background"
                            android:padding="4dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/typeExpenseButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:text="Expense"
                                android:textAllCaps="false"
                                android:textSize="14sp"
                                app:cornerRadius="999dp"
                                app:backgroundTint="@color/color_expense"
                                android:textColor="@color/white"
                                app:strokeWidth="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/typeIncomeButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:text="Income"
                                android:textAllCaps="false"
                                android:textSize="14sp"
                                app:cornerRadius="999dp"
                                app:backgroundTint="@android:color/transparent"
                                android:textColor="@color/color_on_surface_muted"
                                app:strokeWidth="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Amount -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Amount *"
                            android:textSize="13sp"
                            android:textColor="@color/color_on_surface_muted"
                            android:layout_marginBottom="8dp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="64dp">

                            <EditText
                                android:id="@+id/amountEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingStart="64dp"
                                android:paddingEnd="16dp"
                                android:hint="0.00"
                                android:background="@drawable/rounded_input_background"
                                android:inputType="numberDecimal"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.Finora.NumericXl"
                                android:textSize="26sp"
                                android:textColor="@color/color_on_surface"
                                android:textColorHint="@color/color_on_surface_faint" />

                            <TextView
                                android:id="@+id/currencyButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹"
                                android:textSize="20sp"
                                android:textColor="@color/color_primary"
                                android:textStyle="bold"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="16dp"
                                android:paddingEnd="6dp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:minWidth="40dp"
                                android:gravity="center" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Recipient -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Recipient *"
                            android:textSize="13sp"
                            android:textColor="@color/color_on_surface_muted"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/recipientEditText"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:hint="Enter recipient name"
                            android:background="@drawable/rounded_input_background"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1"
                            android:textSize="15sp"
                            android:textColor="@color/color_on_surface"
                            android:textColorHint="@color/color_on_surface_faint"
                            android:gravity="center_vertical" />
                    </LinearLayout>

                    <!-- Note -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Note"
                            android:textSize="13sp"
                            android:textColor="@color/color_on_surface_muted"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/noteEditText"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:paddingStart="16dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp"
                            android:hint="Add a note (optional)"
                            android:background="@drawable/rounded_input_background"
                            android:inputType="textCapSentences|textMultiLine"
                            android:textSize="15sp"
                            android:textColor="@color/color_on_surface"
                            android:textColorHint="@color/color_on_surface_faint"
                            android:gravity="top" />
                    </LinearLayout>

                    <!-- Category Selection -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Category"
                            android:textSize="13sp"
                            android:textColor="@color/color_on_surface_muted"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/categorySelector"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/rounded_input_background"
                            android:clickable="true"
                            android:focusable="true">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/shape_circle"
                                android:backgroundTint="@color/color_glass_fill_l3"
                                android:layout_marginEnd="12dp">

                                <ImageView
                                    android:id="@+id/categorySelectorEmoji"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="7dp"
                                    android:scaleType="centerInside"
                                    android:tint="@color/color_primary"
                                    android:contentDescription="Category icon" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/categorySelectorName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Select category"
                                android:textSize="15sp"
                                android:textColor="@color/color_on_surface_faint" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chevron_down"
                                android:contentDescription="Select"
                                android:tint="@color/color_on_surface_faint" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Date & Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Date &amp; Time"
                            android:textSize="13sp"
                            android:textColor="@color/color_on_surface_muted"
                            android:layout_marginBottom="8dp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp">

                            <EditText
                                android:id="@+id/dateTimeEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingStart="46dp"
                                android:paddingEnd="16dp"
                                android:hint="Tap to select date and time"
                                android:background="@drawable/rounded_input_background"
                                android:inputType="none"
                                android:maxLines="1"
                                android:textSize="15sp"
                                android:textColor="@color/color_on_surface"
                                android:textColorHint="@color/color_on_surface_faint"
                                android:gravity="center_vertical" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_calendar_month"
                                android:tint="@color/color_on_surface_faint"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="14dp"
                                android:contentDescription="Calendar" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Transaction ID -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Transaction ID"
                            android:textSize="13sp"
                            android:textColor="@color/color_on_surface_muted"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/transactionIdEditText"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:hint="UPI/XXXXXXXXXXXX"
                            android:background="@drawable/rounded_input_background"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="15sp"
                            android:textColor="@color/color_on_surface_muted"
                            android:textColorHint="@color/color_on_surface_faint"
                            android:gravity="center_vertical" />
                    </LinearLayout>

                    <!-- Payment Method -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Payment Method"
                            android:textSize="13sp"
                            android:textColor="@color/color_on_surface_muted"
                            android:layout_marginBottom="8dp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp">

                            <Spinner
                                android:id="@+id/bankEditText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingStart="46dp"
                                android:paddingEnd="16dp"
                                android:background="@drawable/rounded_input_background"
                                android:popupBackground="@drawable/spinner_popup_background"
                                android:layout_gravity="center_vertical" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_menu_send"
                                android:tint="@color/color_on_surface_faint"
                                android:layout_gravity="center_vertical|start"
                                android:layout_marginStart="14dp"
                                android:contentDescription="Payment" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.example.expensetracker.ui.common.GlassCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Action Buttons Footer -->
    <LinearLayout
        android:id="@+id/editFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            style="@style/Widget.Finora.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Cancel"
            android:textSize="15sp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Widget.Finora.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Save"
            android:textSize="15sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
