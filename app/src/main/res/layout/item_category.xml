<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorGlassBorder"
    app:cardBackgroundColor="?attr/colorGlassFillL2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Category Icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="?attr/colorGlassFillL3"
            app:cardElevation="0dp"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/categoryEmoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:tint="@color/color_primary"
                android:contentDescription="Category icon" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/categoryNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginEnd="8dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/categoryTypeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:fontFamily="@font/inter"
                android:textColor="?attr/colorOnSurfaceFaint" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/editButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/color_primary"
            android:background="@drawable/edit_btn_bg"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="8dp"
            android:contentDescription="Edit category" />

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_delete"
            android:tint="@color/color_expense"
            android:background="@drawable/delete_btn_bg"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:contentDescription="Delete category" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
