<?xml version="1.0" encoding="utf-8"?>
<com.example.expensetracker.ui.common.GlassCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:glassLevel="level3"
    app:glassCornerRadius="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@color/color_glass_border_bright"
            android:layout_marginBottom="4dp" />

        <!-- Header: title + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/sheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Category"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/hanken_grotesk"
                android:textColor="@color/color_on_surface" />

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_close"
                android:tint="@color/color_on_surface_muted"
                android:background="@drawable/shape_circle"
                android:padding="10dp"
                android:contentDescription="Close" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create a custom bucket for your expenses."
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/color_on_surface_muted"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp" />

        <!-- Category Name section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <EditText
                android:id="@+id/categoryNameInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Category name"
                android:inputType="textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_glass_input"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_on_surface_faint"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Select Icon label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHOOSE AN ICON"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:fontFamily="@font/inter"
            android:textColor="@color/color_on_surface_faint"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="10dp" />

        <!-- Icon grid in scrollable area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="196dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <GridLayout
                    android:id="@+id/iconPickerGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:useDefaultMargins="false" />

            </androidx.core.widget.NestedScrollView>

            <!-- Scroll hint: fade to card color at bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_gravity="bottom"
                android:background="@drawable/scroll_fade_bottom"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/Widget.Finora.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Cancel" />

            <View android:layout_width="12dp" android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addCategoryButton"
                style="@style/Widget.Finora.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Save" />

        </LinearLayout>

    </LinearLayout>
</com.example.expensetracker.ui.common.GlassCardView>
