<?xml version="1.0" encoding="utf-8"?>
<com.example.expensetracker.ui.common.GlassCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:glassLevel="level3"
    app:glassCornerRadius="24dp"
    app:glassTopCornersOnly="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/shape_drag_handle" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/splitSheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Split Transaction"
                android:textAppearance="@style/TextAppearance.Finora.BodyLg"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/closeSplitSheetButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/shape_circle"
                android:src="@drawable/ic_close"
                android:padding="8dp"
                android:tint="?attr/colorOnSurfaceMuted"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Total + remaining -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/splitTotalText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceMuted" />

            <TextView
                android:id="@+id/splitRemainingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Split lines -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/splitLinesScrollView"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/splitLinesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addSplitLineButton"
            style="@style/Widget.Finora.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:text="Add Category"
            app:icon="@android:drawable/ic_input_add"
            app:iconTint="@color/color_primary"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveSplitButton"
            style="@style/Widget.Finora.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:text="Save Split"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/removeSplitButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="4dp"
            android:text="Remove Split"
            android:textColor="@color/color_expense"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</com.example.expensetracker.ui.common.GlassCardView>
