<?xml version="1.0" encoding="utf-8"?>
<!-- Luminous Finance dashed drop-zone: frosted glass fill + dashed indigo-tinted border,
     used by the Statement Import "upload" state drop zone. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/color_glass_fill_l2" />
    <stroke
        android:width="1.5dp"
        android:color="@color/color_glass_border_bright"
        android:dashWidth="8dp"
        android:dashGap="6dp" />
    <corners android:radius="24dp" />
</shape>
