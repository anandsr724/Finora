<?xml version="1.0" encoding="utf-8"?>
<!-- Luminous Finance "Level 1" base background: deep indigo canvas with three large, soft
     glow orbs, matching the Stitch "Home" reference's exact composition (.glow-orb elements:
     top-left primary-container/20 #8083ff, right-middle secondary-container/10 #571bc1 —
     the largest orb, bottom-left tertiary-container/10 #00885e). Radial gradients fade to
     transparent at their edges, approximating the reference's blur(80px) without needing
     actual RenderEffect blur (which can't composite behind opaque scrolling content anyway). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_bg" />
        </shape>
    </item>
    <item
        android:width="380dp"
        android:height="380dp"
        android:gravity="left|top"
        android:left="-110dp"
        android:top="-110dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:startColor="#4D8083FF"
                android:centerColor="#148083FF"
                android:endColor="#008083FF" />
        </shape>
    </item>
    <item
        android:width="440dp"
        android:height="440dp"
        android:gravity="right|center_vertical"
        android:right="-140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="#40571BC1"
                android:centerColor="#12571BC1"
                android:endColor="#00571BC1" />
        </shape>
    </item>
    <item
        android:width="380dp"
        android:height="380dp"
        android:gravity="left|bottom"
        android:left="10dp"
        android:bottom="-140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:startColor="#4000885E"
                android:centerColor="#1200885E"
                android:endColor="#0000885E" />
        </shape>
    </item>
</layer-list>
