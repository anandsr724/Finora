<?xml version="1.0" encoding="utf-8"?>
<!-- Fully-opaque circle, tinted at runtime via setColorFilter — used for the category badge
     dot specifically, since shape_circle.xml's own low-alpha glass fill caps the tinted
     result's opacity, making the dot read as washed-out regardless of tint color. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/white" />
</shape>
