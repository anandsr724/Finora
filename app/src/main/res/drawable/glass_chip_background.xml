<?xml version="1.0" encoding="utf-8"?>
<!-- Small frosted glass chip background — used for compact info chips (e.g. supported
     bank names) inside Luminous Finance glass cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorGlassFillL2" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorGlassBorder" />
    <corners android:radius="14dp" />
</shape>
